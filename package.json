{
  "name": "veylingstudio",
  "version": "1.0.0",
  "description": "Veylings game development studio",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "start": "electron ."
  },
  "keywords": [],
  "author": "AminMasud",
  "license": "ISC",
  "dependencies": {
    "electron": "^44.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}